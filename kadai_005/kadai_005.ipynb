   "source": [
    "# 台形の面積を計算する\n",
    "# 上辺：10cm、下辺：20cm、高さ：5cm\n",
    "\n",
    "upper_base = 10\n",
    "lower_base = 20\n",
    "height = 5\n",
    "\n",
    "area = ((upper_base + lower_base) * height) / 2\n",
    "print(f\"{area}cm²\")"
   ]
  }
